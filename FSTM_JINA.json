    {
      "parameters": {
        "jsCode": "const emb = $input.first().json.data?.[0]?.embedding;\nif (!emb) throw new Error('Pas d\\'embedding Jina');\n\nconst question = $('Question ÔåÆ Jina Body').first().json.question;\n\n// Extraire les mots-cl├®s pour filtre textuel\nconst mots = question.toLowerCase().split(/\\s+/).filter(m => m.length > 3);\nconst keyword = mots.length > 0 ? mots[0] : '';\n\nreturn [{ json: {\n  question,\n  keyword,\n  qdrantBody: JSON.stringify({\n    vector: emb,\n    limit: 15,\n    with_payload: true,\n    score_threshold: 0.05\n  })\n}}];"
      },
      "id": "c4640d7b-c911-420e-9b1b-43cb196e255a",
      "name": "ÔåÆ Qdrant Body",
