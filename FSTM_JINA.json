    {
      "parameters": {
        "jsCode": "// 1) Extraire la question + 2) Pr├®parer le body Jina en un seul n┼ôud\nconst body = $input.first().json.body || $input.first().json;\nconst question = (body.question || body.message || body.text || '').trim();\nif (!question) throw new Error('Question vide');\n\nreturn [{ json: {\n  question,\n  jinaBody: JSON.stringify({\n    model: 'jina-embeddings-v3',\n    task: 'text-matching',\n    dimensions: 768,\n    input: [question]\n  })\n}}];"
      },
